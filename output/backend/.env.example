# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
DATABASE_URL=postgresql://q_user:q_password@localhost:5432/q_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ─── Twilio (OTP / SMS) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...

# ─── AWS S3 (ID / selfie image storage) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=q-platform-private-uploads

# ─── Platform Config ─────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=1
PAYOUT_CRON_SCHEDULE=0 3 * * 1/2
# Every other Monday at 3:00 AM UTC

# ─── Google Maps (for geocoding / geo boundary tools) ────────────────────────
GOOGLE_MAPS_API_KEY=...
